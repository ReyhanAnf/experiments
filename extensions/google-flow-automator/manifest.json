{
  "manifest_version": 3,
  "name": "Timelapse Continuity — Google Flow Automator",
  "version": "1.0.0",
  "description": "Automasi input prompt dan penautan aset Start/End Frame di Google Flow (Google Labs Veo/Imagen).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Timelapse Continuity Flow Automator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://aitestkitchen.withgoogle.com/*",
    "https://*.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
